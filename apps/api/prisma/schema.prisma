generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          String    @default("MEMBER")
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  member        Member?
  auditLogs     AuditLog[]

}

model Member {
  id                String       @id @default(cuid())
  memberId          String       @unique // SRN-CHN-0001
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id])
  fullName          String
  dob               DateTime
  gender            String
  contact           String
  address           String
  state             String
  district          String
  country           String       @default("India")
  pincode           String
  aadhaarNumber     String       // encrypted application value
  aadhaarHash       String       @unique // HMAC lookup value
  panNumber         String       // encrypted application value
  panHash           String       @unique // HMAC lookup value
  course            String?
  seatBookingNumber String?
  designation       String?
  department        String?
  bloodGroup        String?
  emergencyContact  String?
  issueDate         DateTime     @default(now())
  expiryDate        DateTime?
  aadhaarDocUrl     String?
  panDocUrl         String?
  photoUrl          String?
  nomineeName       String?
  nomineeRelation   String?
  nomineeAge        Int?
  kycStatus         String       @default("PENDING")
  status            String       @default("ACTIVE")
  joinedAt          DateTime     @default(now())
  deactivatedAt     DateTime?
  exitDate          DateTime?
  exitReason        String?
  
  // Financial relations
  shareAccounts    ShareAccount[]
  depositAccounts  DepositAccount[]
  pigmyAccounts    PigmyAccount[]
  loans            Loan[]
  depositApplications DepositApplication[]
}

model ShareAccount {
  id              String   @id @default(cuid())
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id])
  sharesOwned     Int      @default(0)
  shareValue      Float
  processingFee   Float
  totalAmount     Float
  createdAt       DateTime @default(now())
}

model DepositAccount {
  id              String           @id @default(cuid())
  accountNumber   String           @unique
  memberId        String
  member          Member           @relation(fields: [memberId], references: [id])
  type            String
  balance         Float            @default(0)
  interestRate    Float
  maturityAmount  Float?
  maturityDate    DateTime?
  isMatured       Boolean          @default(false)
  startDate       DateTime?
  endDate         DateTime?
  monthlyPaymentDate Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  transactions    DepositTransaction[]
}

model DepositTransaction {
  id                String          @id @default(cuid())
  accountId         String
  account           DepositAccount  @relation(fields: [accountId], references: [id])
  amount            Float
  type              String
  paymentMode       String          // CASH, CHEQUE, ONLINE
  referenceNumber   String?
  balanceAfter      Float
  createdAt         DateTime        @default(now())
}

model Loan {
  id              String       @id @default(cuid())
  loanNumber      String       @unique
  memberId        String
  member          Member       @relation(fields: [memberId], references: [id])
  type            String       // Personal, Home, Gold etc
  amount          Float
  interestRate    Float
  purpose         String
  guarantorDetail String?
  
  // New fields for comprehensive loan system
  employmentStatus String?     // Salaried, Self-Employed, etc.
  monthlyIncome   Float?
  documents       String?      // Stored as JSON string for SQLite
  adminRemarks    String?
  
  registeredId    String?
  processingCharges Float?
  documentationCharges Float?
  otherCharges    Float?
  netDisbursed    Float?

  startDate       DateTime?
  endDate         DateTime?
  monthlyPaymentDate Int?

  status          String       @default("PENDING")
  termMonths      Int
  disbursedAt     DateTime?
  closedAt        DateTime?
  emiSchedule     EmiSchedule[]
  repayments      LoanRepayment[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt @default(now())
}

model EmiSchedule {
  id              String   @id @default(cuid())
  loanId          String
  loan            Loan     @relation(fields: [loanId], references: [id])
  dueDate         DateTime
  principalPart   Float
  interestPart    Float
  totalEmi        Float
  isPaid          Boolean  @default(false)
  paidAt          DateTime?
}

model LoanRepayment {
  id              String   @id @default(cuid())
  loanId          String
  loan            Loan     @relation(fields: [loanId], references: [id])
  amount          Float
  penaltyAmount   Float    @default(0)
  paymentMode     String
  referenceNumber String?
  createdAt       DateTime @default(now())
}

model LedgerAccount {
  id            String   @id @default(cuid())
  code          String   @unique // e.g. 1001
  name          String
  category      String   // Asset, Liability, Income, Expense
  type          String?  // ASSET, LIABILITY, etc.
  balance       Float    @default(0)
  createdAt     DateTime @default(now())
  entries       LedgerEntry[]
}

model LedgerEntry {
  id              String         @id @default(cuid())
  accountId       String
  account         LedgerAccount  @relation(fields: [accountId], references: [id])
  debit           Float          @default(0)
  credit          Float          @default(0)
  description     String
  referenceType   String?        // LOAN, DEPOSIT, EXPENSE
  referenceId     String?
  createdAt       DateTime       @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  module      String
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  memberId    String?
  title       String
  message     String
  type        String   // EMAIL, SMS, APP
  isRead      Boolean  @default(false)
  sentAt      DateTime @default(now())
}

model PigmyScheme {
  id              String   @id @default(cuid())
  name            String
  type            String   // DAILY, WEEKLY, MONTHLY
  minAmount       Float
  maxAmount       Float
  interestRate    Float    @default(3.0) // 3%
  interestPeriod  Int      @default(6)   // Months
  maturityPeriod  Int      // Months
  isActive        Boolean  @default(true)
  accounts        PigmyAccount[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt @default(now())
}

model PigmyAccount {
  id              String   @id @default(cuid())
  accountNumber   String   @unique // PIGMY0001
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id])
  schemeId        String
  scheme          PigmyScheme @relation(fields: [schemeId], references: [id])
  agentId         String?  // Assigned collection agent
  allocationDate  DateTime?
  allocationCycle Int?
  allocationSequence Int?
  startDate       DateTime @default(now())
  maturityDate    DateTime
  endDate         DateTime?
  monthlyPaymentDate Int?
  status          String   @default("ACTIVE") // ACTIVE, MATURED, CLOSED
  registeredId    String?
  balance         Float    @default(0)
  totalPaidDays   Int      @default(0)
  interestEarned  Float    @default(0)
  lastInterestCalc DateTime?
  collections     PigmyCollection[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt @default(now())
}

model PigmyCollection {
  id              String   @id @default(cuid())
  transactionId   String   @unique // TXN-PIG-XXXXX
  accountId       String
  account         PigmyAccount @relation(fields: [accountId], references: [id])
  amount          Float
  date            DateTime @default(now())
  method          String   // CASH, UPI
  upiId           String?  // User's UPI ID
  status          String   @default("PENDING") // PENDING, COMPLETED, REJECTED
  referenceId     String?  // External ref or UTR
  agentId         String?  // Collector if manual (User ID)
  receiptNumber   String?  @unique
  remarks         String?
  
  // Payment Intent Details
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  description     String?

  createdAt       DateTime @default(now())
}

model DepositApplication {
  id                String      @id @default(cuid())
  applicationNo   String      @unique // e.g. SHR-DP-FD-123456
  memberId        String
  member          Member      @relation(fields: [memberId], references: [id])
  type            String      // FD, RD, PIGMY
  amount          Float       // Principal amount
  interestRate    Float
  termMonths      Int
  status          String      @default("PENDING") // PENDING, APPROVED, REJECTED
  registeredId    String?
  startDate       DateTime?
  endDate         DateTime?
  monthlyPaymentDate Int?
  documents       String?     // JSON string of file paths (idProof, incomeProof, applicantPhoto, applicantSignature, panProof)
  additionalDetails String?   // JSON string of nominee, bank, sourceOfFunds, expectedMaturity, etc.
  adminRemarks    String?
  approvedBy      String?
  approvedDate    DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?
}

model Agent {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  fullName     String
  phone        String?
  agentCode    String   @unique
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?
}

model OfficeExpense {
  id                 String   @id @default(cuid())
  date               DateTime @default(now())
  type               String   // EXPENSE or INCOME
  description        String
  amount             Float
  modeOfTransaction  String   // CASH, BANK_TRANSFER, UPI, CHEQUE, OTHER
  remarks            String?
  addedBy            String   // Logged in admin name
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
