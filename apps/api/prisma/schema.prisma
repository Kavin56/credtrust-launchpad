generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          String    @default("MEMBER")
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?
  member        Member?
  auditLogs     AuditLog[]
}

model Member {
  id                String       @id @default(cuid())
  memberId          String       @unique // MEM0001
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id])
  fullName          String
  dob               DateTime
  contact           String
  address           String
  aadhaarNumber     String       @unique // Encrypted
  panNumber         String       @unique // Encrypted
  photoUrl          String?
  nomineeName       String?
  nomineeRelation   String?
  nomineeAge        Int?
  kycStatus         String       @default("PENDING")
  status            String       @default("ACTIVE")
  joinedAt          DateTime     @default(now())
  deactivatedAt     DateTime?
  exitDate          DateTime?
  exitReason        String?
  
  // Financial relations
  shareAccounts    ShareAccount[]
  depositAccounts  DepositAccount[]
  loans            Loan[]
}

model ShareAccount {
  id              String   @id @default(cuid())
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id])
  sharesOwned     Int      @default(0)
  shareValue      Float
  processingFee   Float
  totalAmount     Float
  createdAt       DateTime @default(now())
}

model DepositAccount {
  id              String           @id @default(cuid())
  accountNumber   String           @unique
  memberId        String
  member          Member           @relation(fields: [memberId], references: [id])
  type            String
  balance         Float            @default(0)
  interestRate    Float
  maturityAmount  Float?
  maturityDate    DateTime?
  isMatured       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  transactions    DepositTransaction[]
}

model DepositTransaction {
  id                String          @id @default(cuid())
  accountId         String
  account           DepositAccount  @relation(fields: [accountId], references: [id])
  amount            Float
  type              String
  paymentMode       String          // CASH, CHEQUE, ONLINE
  referenceNumber   String?
  balanceAfter      Float
  createdAt         DateTime        @default(now())
}

model Loan {
  id              String       @id @default(cuid())
  loanNumber      String       @unique
  memberId        String
  member          Member       @relation(fields: [memberId], references: [id])
  type            String       // Personal, Home, Gold etc
  amount          Float
  interestRate    Float
  purpose         String
  guarantorDetail String?
  
  // New fields for comprehensive loan system
  employmentStatus String?     // Salaried, Self-Employed, etc.
  monthlyIncome   Float?
  documents       String?      // Stored as JSON string for SQLite
  adminRemarks    String?
  
  status          String       @default("PENDING")
  termMonths      Int
  disbursedAt     DateTime?
  closedAt        DateTime?
  emiSchedule     EmiSchedule[]
  repayments      LoanRepayment[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt @default(now())
}

model EmiSchedule {
  id              String   @id @default(cuid())
  loanId          String
  loan            Loan     @relation(fields: [loanId], references: [id])
  dueDate         DateTime
  principalPart   Float
  interestPart    Float
  totalEmi        Float
  isPaid          Boolean  @default(false)
  paidAt          DateTime?
}

model LoanRepayment {
  id              String   @id @default(cuid())
  loanId          String
  loan            Loan     @relation(fields: [loanId], references: [id])
  amount          Float
  penaltyAmount   Float    @default(0)
  paymentMode     String
  referenceNumber String?
  createdAt       DateTime @default(now())
}

model LedgerAccount {
  id            String   @id @default(cuid())
  code          String   @unique // e.g. 1001
  name          String
  category      String   // Asset, Liability, Income, Expense
  type          String?  // ASSET, LIABILITY, etc.
  balance       Float    @default(0)
  createdAt     DateTime @default(now())
  entries       LedgerEntry[]
}

model LedgerEntry {
  id              String         @id @default(cuid())
  accountId       String
  account         LedgerAccount  @relation(fields: [accountId], references: [id])
  debit           Float          @default(0)
  credit          Float          @default(0)
  description     String
  referenceType   String?        // LOAN, DEPOSIT, EXPENSE
  referenceId     String?
  createdAt       DateTime       @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  module      String
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  memberId    String?
  title       String
  message     String
  type        String   // EMAIL, SMS, APP
  isRead      Boolean  @default(false)
  sentAt      DateTime @default(now())
}
