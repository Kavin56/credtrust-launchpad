NODE_ENV=production
PORT=8080
# Supabase pooled PostgreSQL connection URL. Add ?pgbouncer=true&connection_limit=1 for Prisma.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
JWT_SECRET=generate-a-strong-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=generate-a-different-strong-random-secret-at-least-32-characters
ENCRYPTION_KEY=generate-a-64-character-hex-key
ADMIN_ACCESS_KEY=generate-a-strong-admin-access-key
ADMIN_SIGNUP_SECRET=generate-a-different-strong-admin-signup-secret
CORS_ORIGINS=https://your-firebase-hosting-domain.web.app,https://your-custom-domain.example
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
# On Cloud Run use Application Default Credentials; do not set FIREBASE_PRIVATE_KEY.
ENABLE_SWAGGER=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-before-seeding
