# ==============================================================================
# CredTrust API - Backend Environment Configuration
# ==============================================================================

NODE_ENV=production
# PORT is injected by Cloud Run automatically — do NOT set it here

# ------------------------------------------------------------------------------
# Cloud SQL for PostgreSQL (europe-west1) - project-934de704-b710-47c7-ac6
# Instance: credtrust-postgres   Connection name:
#   project-934de704-b710-47c7-ac6:europe-west1:credtrust-postgres
# Password '@' is encoded as '%40'
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:Credtrust%402026Db@35.205.59.43:5432/postgres?schema=public&connection_limit=5
ADMIN_DATABASE_URL=postgresql://postgres:Credtrust%402026Db@35.205.59.43:5432/postgres?schema=admin&connection_limit=5
AGENT_DATABASE_URL=postgresql://postgres:Credtrust%402026Db@35.205.59.43:5432/postgres?schema=agent&connection_limit=5

# ------------------------------------------------------------------------------
# Security & JWT Tokens
# ------------------------------------------------------------------------------
JWT_SECRET=credtrust_jwt_secret_key_super_secure_2026_random_token_99
JWT_REFRESH_SECRET=credtrust_refresh_secret_key_super_secure_2026_random_token_88
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_ACCESS_KEY=SRSAdminSecureKey2026!
ADMIN_SIGNUP_SECRET=SRSSignupSecretKey2026!

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# ------------------------------------------------------------------------------
CORS_ORIGINS=https://credtrust-launchpad.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# Firebase Admin (Authentication)
# ------------------------------------------------------------------------------
# MUST match the frontend Firebase project (credtrust-8e924 in src/lib/firebase.ts),
# otherwise verifyFirebaseToken() fails and /auth/firebase/session returns 500.
# Prefer FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY (works on Cloud Run too).
# The private key must keep its \n line breaks.
FIREBASE_PROJECT_ID=credtrust-8e924
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@credtrust-8e924.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# Google Cloud Storage (KYC document storage) — raw files, NO OCR
# ------------------------------------------------------------------------------
# The GCS bucket lives in a DIFFERENT GCP project than the Firebase project.
# Uploads use @google-cloud/storage with Application Default Credentials
# (automatic on Cloud Run; locally run `gcloud auth application-default login`).
FIREBASE_STORAGE_BUCKET=srs-bank-storage-934de704
GCS_BUCKET_NAME=srs-bank-storage-934de704
GCS_PROJECT_ID=project-934de704-b710-47c7-ac6
