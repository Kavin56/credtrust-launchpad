# ==============================================================================
# CredTrust API - Backend Environment Configuration
# ==============================================================================

NODE_ENV=production
# PORT is injected by Cloud Run automatically — do NOT set it here

# ------------------------------------------------------------------------------
# Supabase PostgreSQL (Transaction Pooler — port 6543 with pgbouncer)
# Password '@' is encoded as '%40'
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.pujouwnvpxbrxedwncrp:SRSTRUST%40123@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
ADMIN_DATABASE_URL=postgresql://postgres.pujouwnvpxbrxedwncrp:SRSTRUST%40123@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=admin
AGENT_DATABASE_URL=postgresql://postgres.pujouwnvpxbrxedwncrp:SRSTRUST%40123@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=agent

# ------------------------------------------------------------------------------
# Security & JWT Tokens
# ------------------------------------------------------------------------------
JWT_SECRET=credtrust_jwt_secret_key_super_secure_2026_random_token_99
JWT_REFRESH_SECRET=credtrust_refresh_secret_key_super_secure_2026_random_token_88
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_ACCESS_KEY=SRSAdminSecureKey2026!
ADMIN_SIGNUP_SECRET=SRSSignupSecretKey2026!

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# ------------------------------------------------------------------------------
CORS_ORIGINS=https://credtrust-launchpad.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# Google Cloud Storage — Firebase account bucket (credtrust-8e924)
# On Cloud Run, Application Default Credentials are used automatically.
# Do NOT set FIREBASE_PRIVATE_KEY for Cloud Run deployments.
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=credtrust-8e924
FIREBASE_STORAGE_BUCKET=credtrust-8e924.firebasestorage.app
