# ------------------------------------------------------------------------------
# Document storage (KYC images / PDFs) - stored on the Cloud Run container
# ------------------------------------------------------------------------------
# Uploaded files are written to /app/uploads/<type>/ inside the container and
# are streamed back through GET /api/v1/storage/view?path=...
# Raw bytes only - NO OCR, NO image text extraction.
UPLOAD_DIR="/app/uploads"
