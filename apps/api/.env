ADMIN_DATABASE_URL="postgresql://postgres.pujouwnvpxbrxedwncrp:SRSTRUST%40123@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?schema=admin&connection_limit=5"
AGENT_DATABASE_URL="postgresql://postgres.pujouwnvpxbrxedwncrp:SRSTRUST%40123@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?schema=agent&connection_limit=5"
