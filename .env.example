VITE_GEMINI_API_KEY=
VITE_API_BASE_URL=https://your-cloud-run-service-url/api/v1

# Backend API
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
JWT_SECRET=replace-with-a-strong-random-value
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-value
ENCRYPTION_KEY=replace-with-a-64-character-hex-key
CORS_ORIGINS=https://your-firebase-hosting-domain.web.app
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
