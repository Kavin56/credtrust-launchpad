# ==============================================================================
# CredTrust / SRS Society - Environment Configuration Template
# Copy this file to .env and adjust variables accordingly
# ==============================================================================

NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Databases (Prisma Multi-Schema)
# Password '@' must be encoded as '%40' in URL
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:SRSbank%40123@db.rgtjpygrfvnlozsoxndq.supabase.co:5432/postgres?schema=public
ADMIN_DATABASE_URL=postgresql://postgres:SRSbank%40123@db.rgtjpygrfvnlozsoxndq.supabase.co:5432/postgres?schema=admin
AGENT_DATABASE_URL=postgresql://postgres:SRSbank%40123@db.rgtjpygrfvnlozsoxndq.supabase.co:5432/postgres?schema=agent

# ------------------------------------------------------------------------------
# 2. Security & JWT Secrets (at least 32 characters)
# ------------------------------------------------------------------------------
JWT_SECRET=credtrust_jwt_secret_key_super_secure_2026_random_token_99
JWT_REFRESH_SECRET=credtrust_refresh_secret_key_super_secure_2026_random_token_88
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ADMIN_ACCESS_KEY=SRSAdminSecureKey2026!
ADMIN_SIGNUP_SECRET=SRSSignupSecretKey2026!

# ------------------------------------------------------------------------------
# 3. CORS Allowed Origins (Comma-separated)
# ------------------------------------------------------------------------------
CORS_ORIGINS=https://credtrust-launchpad.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 4. Google Cloud / Firebase Storage (PDFs, Images, Documents)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=project-934de704-b710-47c7-ac6
FIREBASE_STORAGE_BUCKET=credtrust-storage-0156201953

# ------------------------------------------------------------------------------
# 5. Frontend Client Variables (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://credtrust-launchpad-123280259621.europe-west1.run.app/api/v1
VITE_AUTH_PROVIDER=firebase
